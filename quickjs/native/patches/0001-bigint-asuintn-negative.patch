+        if (!js_bigint_sign(p) && bits >= (uint64_t)p->len * JS_LIMB_BITS)
+            res = a;
+        else
+            res = js_bigint_truncate_unsigned(ctx, a, bits);
     } else {
         JSBigInt *r, *p = JS_VALUE_GET_PTR(a);
         if (bits >= p->len * JS_LIMB_BITS) {
@@ -56334,10 +56383,7 @@ static JSValue js_bigint_asUintN(JSContext *ctx,

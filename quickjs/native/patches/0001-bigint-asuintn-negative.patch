@@ -56284,6 +56284,42 @@ static JSValue js_bigint_valueOf(JSContext *ctx, JSValueConst this_val,
     return js_thisBigIntValue(ctx, this_val);
 }
 
+/* the low `bits` bits of `a`, zero extended. BigInt.asUintN never returns a
+   negative number, so one limb more than `bits` needs is allocated: without it
+   the top bit of the last limb would be read back as a sign. */
+static JSValue js_bigint_truncate_unsigned(JSContext *ctx, JSValue a,
+                                           uint64_t bits)
+{
+    JSBigIntBuf buf;
+    JSBigInt *r, *p;
+    uint64_t len;
+    int i, shift, sign;
+
+    len = bits / JS_LIMB_BITS + 1;
+    if (len > JS_BIGINT_MAX_SIZE) {
+        JS_FreeValue(ctx, a);
+        JS_ThrowRangeError(ctx, "BigInt is too large to allocate");
+        return JS_EXCEPTION;
+    }
+    p = JS_ToBigIntBuf(ctx, &buf, a);
+    sign = js_bigint_sign(p);
+    r = js_bigint_new(ctx, len);
+    if (!r) {
+        JS_FreeValue(ctx, a);
+        return JS_EXCEPTION;
+    }
+    for(i = 0; i < (int)len; i++)
+        r->tab[i] = i < p->len ? p->tab[i] : (sign ? (js_limb_t)-1 : 0);
+    shift = bits & (JS_LIMB_BITS - 1);
+    if (shift == 0)
+        r->tab[len - 1] = 0;
+    else
+        r->tab[len - 1] &= ((js_limb_t)1 << shift) - 1;
+    r = js_bigint_normalize(ctx, r);
+    JS_FreeValue(ctx, a);
+    return JS_CompactBigInt(ctx, r);
+}
+

+               is not one: -1n means 2^bits - 1, which no longer fits here. */
+            if (!asIntN && JS_VALUE_GET_SHORT_BIG_INT(a) < 0)
+                res = js_bigint_truncate_unsigned(ctx, a, bits);
+            else
+                res = a;
         } else {
             uint64_t v;
             int shift;
@@ -56315,6 +56356,14 @@ static JSValue js_bigint_asUintN(JSContext *ctx,
                 v = v >> shift;
